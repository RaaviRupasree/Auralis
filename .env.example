# ==========================================
# Auralis Environment Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Audio & Speech-to-Text (Faster-Whisper)
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Speech Emotion Recognition (SER)
SER_MODEL_TYPE=acoustic_prosody
SER_CONFIDENCE_THRESHOLD=0.35

# Voice Activity Detection (VAD)
VAD_ENERGY_THRESHOLD=0.015
VAD_SILENCE_DURATION_MS=600

# LLM Configuration (Crisis Negotiation Persona)
# Supported LLM_PROVIDER options: ollama, openai, heuristic_fallback
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.6

# Text-to-Speech (TTS)
TTS_ENGINE=edge-tts
# High quality calm de-escalation voices: en-US-ChristopherNeural, en-US-GuyNeural, en-US-JennyNeural
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Database & Storage
DB_PATH=./auralis.db
SAVE_RAW_AUDIO=false
